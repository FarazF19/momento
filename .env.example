APP_URL=http://localhost:3000
# In the Supabase dashboard, set Site URL to this origin and allow
# http://localhost:3000/auth/callback plus the production callback URL.
# Confirmation emails will not arrive if those redirect URLs are missing.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret (service role) key. Required for automatic
# verification decisions. Never expose it in browser code or commit it.
SUPABASE_SECRET_KEY=

# Legacy prototype only; not connected to Supabase offers. Leave unset for this release.
TAZAPAY_ENV=sandbox
TAZAPAY_API_KEY=
TAZAPAY_API_SECRET=
TAZAPAY_WEBHOOK_SECRET=

# Confirm the applicable purpose code with Tazapay during onboarding.
TAZAPAY_PAYOUT_PURPOSE_CODE=
TAZAPAY_PAYOUT_HOLDING_CURRENCY=USD
TAZAPAY_PLATFORM_FEE_BPS=1000

# Protect delivery approval and automatic payout retry endpoints.
OPERATIONS_SECRET=
CRON_SECRET=
ONBOARDING_TOKEN_SECRET=
