APP_URL=http://localhost:3000
DATABASE_URL=

# Tazapay: use sandbox until marketplace underwriting and end-to-end tests pass.
TAZAPAY_ENV=sandbox
TAZAPAY_API_KEY=
TAZAPAY_API_SECRET=
