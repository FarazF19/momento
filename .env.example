TAZAPAY_PAYOUT_HOLDING_CURRENCY=USD
TAZAPAY_PLATFORM_FEE_BPS=1000

# Protect delivery approval and automatic payout retry endpoints.
OPERATIONS_SECRET=
CRON_SECRET=
ONBOARDING_TOKEN_SECRET=
